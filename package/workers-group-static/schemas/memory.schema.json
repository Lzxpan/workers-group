{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workers Group Memory",
  "type": "object",
  "required": ["id", "content", "contentHash", "source", "status", "createdAt"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "key": {"type": "string"},
    "content": {"type": "string", "minLength": 1},
    "contentHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {"type": "string", "minLength": 1},
    "memoryType": {
      "enum": [
        "EPISODIC",
        "SEMANTIC",
        "PROCEDURAL",
        "DECISION",
        "FAILURE",
        "PREFERENCE",
        "SKILL_EVOLUTION"
      ]
    },
    "status": {"enum": ["CANDIDATE", "ACTIVE", "QUARANTINED", "SUPERSEDED", "STALE"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "reviewedBy": {"enum": ["workers_boss", "workers_qa"]},
    "reviewerArtifact": {
      "type": "object",
      "required": ["memory_id", "reviewer", "verdict", "evidence"],
      "properties": {
        "memory_id": {"type": "string", "minLength": 1},
        "reviewer": {"enum": ["workers_boss", "workers_qa"]},
        "verdict": {"enum": ["APPROVED", "PASS"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
