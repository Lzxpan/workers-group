{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workers Group QA Report",
  "type": "object",
  "required": ["schema_version", "task_id", "role", "overall_verdict", "criteria_results", "design_findings", "regression_findings", "unverified_items", "memory_findings", "evidence", "timestamp"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "role": {"const": "workers_qa"},
    "overall_verdict": {"enum": ["PASS", "FAIL", "PARTIAL", "NOT_VERIFIED", "BLOCKED"]},
    "criteria_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["acceptance_criterion_id", "method", "expected_result", "actual_result", "evidence", "verdict", "severity", "reproduction_steps", "regression_risk", "recommended_action", "memory_validation_result"],
        "properties": {
          "acceptance_criterion_id": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "expected_result": {"type": "string"},
          "actual_result": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "verdict": {"enum": ["PASS", "FAIL", "PARTIAL", "NOT_VERIFIED", "BLOCKED"]},
          "severity": {"type": "string"},
          "reproduction_steps": {"type": "array", "items": {"type": "string"}},
          "regression_risk": {"type": "string"},
          "recommended_action": {"type": "string"},
          "memory_validation_result": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "design_findings": {"type": "array", "items": {"type": "string"}},
    "regression_findings": {"type": "array", "items": {"type": "string"}},
    "unverified_items": {"type": "array", "items": {"type": "string"}},
    "memory_findings": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "timestamp": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
