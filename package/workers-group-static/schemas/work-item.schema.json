{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workers Group Work Item",
  "type": "object",
  "required": ["id", "title", "description", "owner", "dependencies", "acceptance_criterion_ids", "status", "blockers", "evidence"],
  "properties": {
    "id": {"type": "string", "pattern": "^WI-[0-9]+$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "owner": {"enum": ["workers_boss", "workers_planner", "workers_pm", "workers_executor", "workers_qa"]},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "acceptance_criterion_ids": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["NOT_STARTED", "READY", "IN_PROGRESS", "BLOCKED", "NEEDS_REWORK", "READY_FOR_QA", "QA_FAILED", "QA_PASSED", "READY_FOR_BOSS_REVIEW", "DONE", "CANCELLED"]},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
