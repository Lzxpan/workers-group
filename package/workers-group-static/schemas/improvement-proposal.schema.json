{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workers Group Improvement Proposal",
  "type": "object",
  "required": [
    "proposalId",
    "risk",
    "operation",
    "status",
    "target",
    "expectedSha256",
    "failingTest",
    "fullTestsPassed",
    "testEvidence",
    "qaEvidence",
    "qaVerdict",
    "bossReview",
    "version",
    "changelog"
  ],
  "properties": {
    "proposalId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9_-])?$"
    },
    "risk": {
      "enum": ["LOW", "HIGH"]
    },
    "operation": {
      "enum": [
        "update_status_message",
        "retrieval_weights",
        "test_fixture",
        "diagnostics",
        "path_fix",
        "optional_schema_field",
        "text_clarification"
      ]
    },
    "status": {
      "enum": [
        "PROPOSED",
        "SIMULATED",
        "AWAITING_HUMAN_APPROVAL",
        "LOW_RISK_APPROVED",
        "APPROVED",
        "APPLIED",
        "REJECTED",
        "ROLLED_BACK",
        "ROLLBACK_FAILED",
        "DUPLICATE_REFUSED"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "expectedSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "failingTest": {
      "type": "boolean"
    },
    "fullTestsPassed": {
      "type": "boolean"
    },
    "testEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "qaEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "bossEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "bossReviewEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "qaVerdict": {
      "enum": ["PASS", "FAIL", "BLOCKED"]
    },
    "bossReview": {
      "enum": ["PASS", "APPROVED", "FAIL", "REJECTED"]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "changelog": {
      "type": "string",
      "minLength": 1
    },
    "oldValue": {
      "type": "string"
    },
    "newValue": {
      "type": "string"
    },
    "field": {
      "type": "string",
      "minLength": 1
    },
    "value": {},
    "schema": {
      "type": "object"
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "update_status_message",
              "test_fixture",
              "path_fix",
              "text_clarification"
            ]
          }
        }
      },
      "then": {
        "required": ["oldValue", "newValue"]
      }
    },
    {
      "if": {
        "properties": {"operation": {"const": "retrieval_weights"}}
      },
      "then": {
        "required": ["field", "value"]
      }
    },
    {
      "if": {
        "properties": {"operation": {"const": "diagnostics"}}
      },
      "then": {
        "required": ["field", "value"]
      }
    },
    {
      "if": {
        "properties": {"operation": {"const": "optional_schema_field"}}
      },
      "then": {
        "required": ["field", "schema"]
      }
    }
  ],
  "additionalProperties": false
}
