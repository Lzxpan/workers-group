{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workers Group Meeting",
  "type": "object",
  "required": ["schemaVersion", "meetingId", "timestamp", "attendees", "agenda", "facts", "assumptions", "alternatives", "decisions", "actions", "evidence"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "meetingId": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "attendees": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "agenda": {"type": "string", "minLength": 1},
    "facts": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "alternatives": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "evidence",
          "feasibility",
          "implementation_impact",
          "validation_method",
          "risks",
          "rollback",
          "owner",
          "affected_acceptance_criteria",
          "affected_memories",
          "affected_skill_rules"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "feasibility": {"type": "string", "minLength": 1},
          "implementation_impact": {"type": "string", "minLength": 1},
          "validation_method": {"type": "string", "minLength": 1},
          "risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "rollback": {"type": "string", "minLength": 1},
          "owner": {
            "type": "string",
            "enum": ["workers_boss", "workers_planner", "workers_pm", "workers_executor", "workers_qa"]
          },
          "affected_acceptance_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "affected_memories": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "affected_skill_rules": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "decisions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "owner", "due_state"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "owner": {
            "type": "string",
            "enum": ["workers_boss", "workers_planner", "workers_pm", "workers_executor", "workers_qa"]
          },
          "due_state": {
            "type": "string",
            "enum": [
              "INTAKE", "CHARTERED", "PLANNING", "FEASIBILITY_REVIEW", "READY",
              "EXECUTING", "READY_FOR_QA", "QA_REVIEW", "READY_FOR_BOSS_REVIEW",
              "DONE", "BLOCKED", "NEEDS_REWORK", "QA_FAILED", "PARTIAL",
              "FAILED", "CANCELLED"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
