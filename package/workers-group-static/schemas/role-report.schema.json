{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workers Group Role Report",
  "type": "object",
  "required": ["schema_version", "task_id", "work_item_id", "role", "agent_id", "status", "summary", "facts", "assumptions", "actions_taken", "commands_run", "files_changed", "tests", "evidence", "blockers", "risks", "remaining_work", "memories_used", "memory_candidates", "confidence", "timestamp"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "work_item_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["workers_boss", "workers_planner", "workers_pm", "workers_executor", "workers_qa"]},
    "agent_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["INTAKE", "CHARTERED", "PLANNING", "FEASIBILITY_REVIEW", "READY", "EXECUTING", "READY_FOR_QA", "QA_REVIEW", "READY_FOR_BOSS_REVIEW", "DONE", "BLOCKED", "NEEDS_REWORK", "QA_FAILED", "PARTIAL", "FAILED", "CANCELLED", "NOT_STARTED", "IN_PROGRESS", "QA_PASSED"]},
    "summary": {"type": "string", "minLength": 1},
    "facts": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "actions_taken": {"type": "array", "items": {"type": "string"}},
    "commands_run": {"type": "array", "items": {"type": "object"}},
    "files_changed": {"type": "array", "items": {"type": "string"}},
    "tests": {"type": "array", "items": {"type": "object"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "remaining_work": {"type": "array", "items": {"type": "string"}},
    "memories_used": {"type": "array", "items": {"type": "string"}},
    "memory_candidates": {"type": "array", "items": {"type": "object"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "timestamp": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
